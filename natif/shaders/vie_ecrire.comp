#version 450
/* Vie des étoiles (vie_etoiles.h) : écrit le mot « magnitude | couleur | drapeaux » des étoiles dont l'éclat ou la couleur
   calculés ont changé. Changement : (rang de l'étoile, nouveau mot). Positions et vitesses ne sont pas touchées. */
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) buffer Stars { uvec4 star[]; };
layout(std430, set = 0, binding = 1) readonly buffer Changes { uvec2 change[]; };
layout(push_constant) uniform Pc { uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uvec2 c = change[i];
    star[c.x].w = c.y;
}
