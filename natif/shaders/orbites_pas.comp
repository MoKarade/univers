#version 450
/* Un pas d'orbite EXACT pour chaque étoile, dans la Galaxie : port fidèle de phys::galaxie::Potentiel::acc et de
   Orbites::pas (natif/physique/galaxie_orbites.h) : bulbe de Hernquist + disque de Miyamoto-Nagai + halo NFW + barre
   tournante de Dehnen ; saut de grenouille (vitesse de Verlet), sous-pas par étoile.
   Les étoiles ne s'attirent pas entre elles : chaque étoile est avancée seule.
   État d'une étoile (std430) : p = position galactocentrique (kpc), p.w = nombre de sous-pas (1, 2, 8 ou 32) ;
   v = vitesse (km/s), v.w libre (recopié).
   Constantes poussées : t0 = temps au début du pas (milliards d'années), dt = durée du pas (milliards d'années, négative
   pour remonter le temps), first et count = étoiles à traiter (first + i, i < count).
   Lecture dans le tampon 0, écriture dans le tampon 1 (ce peut être le même tampon : chaque étoile ne touche que la sienne).
   essai_orbite.cpp contrôle les constantes ; le contrôle de la fenêtre (--controle-orbites) relit le résultat sur la carte
   et le compare au calcul en double précision de la bibliothèque. */
layout(local_size_x = 256) in;
struct Etat { vec4 p; vec4 v; };
layout(std430, set = 0, binding = 0) readonly buffer Avant { Etat e[]; } avant;
layout(std430, set = 0, binding = 1) writeonly buffer Apres { Etat e[]; } apres;
layout(push_constant) uniform Pc { float t0; float dt; uint first; uint count; } pc;

const float OP_G = 4.30091e-6;
const float OP_MB = 0.5e10;
const float OP_AB = 0.5;
const float OP_MD = 6.8e10;
const float OP_AD = 3.0;
const float OP_BD = 0.28;
const float OP_RS = 16.0;
const float OP_GMH = 2410361.25417129;      /* phys::galaxie::gmHalo() */
const float OP_K = 1.0227121650456;         /* km/s -> kpc par milliard d'années */
const float OP_RB = 5.0;                    /* demi-longueur de la barre (kpc) */
const float OP_ABAR = 777.79646;            /* force de la barre : 0,01 x 230^2 x (8,2 / 5)^3 / 3 */
const float OP_BAR0 = 2.65290046;           /* angle de la barre à t = 0 : pi - 28 degrés */
const float OP_BARW = 39.8857744;           /* rotation de la barre : 39 km/s/kpc, en radians par milliard d'années */

vec3 acc(vec3 x, float t) {
    float R2 = x.x * x.x + x.y * x.y, r = sqrt(R2 + x.z * x.z) + 1e-12, xs = r / OP_RS;
    float ar = -OP_G * OP_MB / ((r + OP_AB) * (r + OP_AB)) - OP_GMH * (log(1.0 + xs) - xs / (1.0 + xs)) / (r * r);
    float B = sqrt(x.z * x.z + OP_BD * OP_BD), D2 = R2 + (OP_AD + B) * (OP_AD + B), D3 = D2 * sqrt(D2), gm = OP_G * OP_MD;
    vec3 a = vec3(ar * x.x / r - gm * x.x / D3, ar * x.y / r - gm * x.y / D3, ar * x.z / r - gm * x.z * (OP_AD + B) / (B * D3));
    if (R2 > 1e-8) {
        float R = sqrt(R2), c = x.x / R, s = x.y / R, psi = atan(x.y, x.x) - (OP_BAR0 - OP_BARW * t);
        float c2 = cos(2.0 * psi), s2 = sin(2.0 * psi), q = R / OP_RB;
        float U = R < OP_RB ? q * q * q - 2.0 : -1.0 / (q * q * q);
        float dU = R < OP_RB ? 3.0 * q * q / OP_RB : 3.0 / (q * q * q * q * OP_RB);
        float aR = -OP_ABAR * c2 * dU, aP = 2.0 * OP_ABAR * s2 * U / R;
        a.x += aR * c - aP * s;
        a.y += aR * s + aP * c;
    }
    return a;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Etat e = avant.e[pc.first + i];
    int m = int(e.p.w);
    float h = pc.dt * OP_K / float(m);
    vec3 X = e.p.xyz, V = e.v.xyz;
    for (int u = 0; u < m; ++u) {
        float ta = pc.t0 + float(u) / float(m) * pc.dt, tb = ta + pc.dt / float(m);
        V += 0.5 * h * acc(X, ta);
        X += h * V;
        V += 0.5 * h * acc(X, tb);
    }
    apres.e[pc.first + i] = Etat(vec4(X, e.p.w), vec4(V, e.v.w));
}
